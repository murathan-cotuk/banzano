# Affiliate Portal — copy to .env.local and fill in values
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_AFFILIATE_API_PREFIX=/affiliate-api/v1
NEXT_PUBLIC_AFFILIATE_PORTAL_URL=http://localhost:3004
NEXT_PUBLIC_SHOP_URL=http://localhost:3000
NEXT_PUBLIC_SELLERCENTRAL_URL=http://localhost:3002

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must match AFFILIATE_JWT_SECRET on the Render backend
AFFILIATE_JWT_SECRET=

