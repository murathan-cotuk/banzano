{
  "name": "medusa-backend",
  "version": "1.0.0",
  "private": true,
  "main": "medusa-config.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "echo 'Medusa backend build skipped'",
    "db:setup": "node scripts/write-env-from-process.js && medusa db:setup --no-interactive",
    "db:migrate": "node scripts/write-env-from-process.js && medusa db:migrate --skip-links",
    "run-migrations": "node scripts/run-migrations.js",
    "db:test": "node scripts/test-db-connection.js",
    "db:reset-stripe-ids": "node scripts/reset-stripe-ids.js",
    "db:categories": "node scripts/list-categories-in-db.js",
    "db:products": "node scripts/list-products-in-db.js",
    "db:menus": "node scripts/list-menus-in-db.js",
    "db:banners": "node scripts/list-banners-in-db.js",
    "db:media": "node scripts/list-media-in-db.js",
    "db:pages": "node scripts/list-pages-in-db.js",
    "db:support-cases": "node scripts/setup-support-cases.js",
    "db:seed-customer-support": "node scripts/setup-customer-support-landing.js",
    "db:seed-become-seller": "node scripts/setup-become-seller-landing.js",
    "postinstall": "node scripts/patch-link-modules.js",
    "patch": "node scripts/patch-link-modules.js",
    "test:eu-origin": "node --test src/eu-origin/metadata.test.js",
    "test:media-filename": "node --test src/media-filename.test.js",
    "test": "node --test --test-reporter=spec src/eu-origin/metadata.test.js src/media-filename.test.js src/support-case-core.test.js src/goods-vat.test.js src/bonus-settlement.test.js src/flow-triggers.test.js src/flow-catalog.test.js src/customer-support-landing-seed.test.js src/store-category-tree.test.js src/modules/affiliate-platform/attribution-engine.test.js src/modules/affiliate-platform/commission-calculator.test.js src/modules/affiliate-platform/codes.test.js src/modules/affiliate-platform/auth.test.js src/product-auto-translate.test.js src/product-url-handle.test.js src/metaobject-locale-remap.test.js",
    "test:support-cases": "node --test --test-reporter=spec src/support-case-core.test.js",
    "test:customer-support-landing": "node --test --test-reporter=spec src/customer-support-landing-seed.test.js",
    "smoke:customer-support-landing": "node scripts/smoke-customer-support-landing.js",
    "typecheck": "node --check server.js && node --check medusa-config.js && node --check src/support-case-core.js && node --check src/support-case-schema.js && node --check src/routes/support-cases.js && node --check src/routes/messages.js && node --check src/routes/pages.js && node --check src/seed-support-case-flows.js && node --check src/flow-automation.js && node --check scripts/setup-support-cases.js"
  },
  "keywords": [
    "medusa",
    "ecommerce",
    "api",
    "mock"
  ],
  "author": "",
  "license": "ISC",
  "description": "Medusa-compatible mock backend (bridge). In-memory API for development/testing. NOT production-ready. Real Medusa v2 integration pending.",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@medusajs/admin": "^7.1.18",
    "@medusajs/admin-ui": "^2.1.18",
    "@medusajs/auth-emailpass": "2.13.1",
    "@medusajs/cli": "^2.13.1",
    "@medusajs/file-local": "2.13.1",
    "@medusajs/framework": "2.13.1",
    "@medusajs/fulfillment-manual": "2.13.1",
    "@medusajs/link-modules": "2.13.1",
    "@medusajs/medusa": "2.13.1",
    "@medusajs/notification-local": "2.13.1",
    "@sentry/node": "^10.35.0",
    "ajv": "^8.17.1",
    "bullmq": "^5.67.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "ioredis": "^5.6.1",
    "medusa": "^0.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.15.0",
    "pg": "^8.13.1",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "resend": "^4.5.1",
    "sharp": "^0.33.5",
    "speakeasy": "^2.0.0",
    "stripe": "^20.3.0",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.20",
    "zod": "^3.25.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.2"
  }
}
